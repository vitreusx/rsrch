	file = {Macario Barros et al_2022_A Comprehensive Survey of Visual SLAM Algorithms.pdf:/home/james/Documents/zotero/Macario Barros et al_2022_A Comprehensive Survey of Visual SLAM Algorithms.pdf:application/pdf},
