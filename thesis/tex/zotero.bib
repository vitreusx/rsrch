	keywords = {Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {arXiv.org Snapshot:/home/james/Zotero/storage/IYWPEGEP/1612.html:text/html;Lakshminarayanan et al_2017_Simple and Scalable Predictive Uncertainty Estimation using Deep Ensembles.pdf:/home/james/Documents/zotero/Lakshminarayanan et al_2017_Simple and Scalable Predictive Uncertainty Estimation using Deep Ensembles.pdf:application/pdf},
