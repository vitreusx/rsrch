	file = {Takida et al. - 2022 - SQ-VAE Variational Bayes on Discrete Representati.pdf:/home/james/Zotero/storage/2Y2ZV7U6/Takida et al. - 2022 - SQ-VAE Variational Bayes on Discrete Representati.pdf:application/pdf},
